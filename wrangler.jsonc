  "triggers": {
    // 매일 06:00·18:00 KST / 일요일 20:00 KST
    "crons": ["0 21 * * *", "0 9 * * *", "0 11 * * sun"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mokdong-edu-bot-db",
